<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>
	<groupId>cn.iocoder.spring-ai</groupId>
	<artifactId>spring-ai-jedis-runtime-compat</artifactId>
	<version>2.1.1-jdk8-SNAPSHOT</version>
	<name>Isolated Jedis 6 runtime for Spring Boot 2</name>
	<description>Relocated Jedis 6 and runtime dependencies for Redis Stack access on Java 8.</description>
	<url>https://github.com/yudaocode/yudao-spring-ai</url>
	<licenses>
		<license><name>MIT (upstream Jedis)</name><url>https://opensource.org/license/mit</url></license>
		<license><name>Apache License, Version 2.0 (compatibility build)</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license>
	</licenses>
	<developers><developer><id>yudaocode</id><name>芋道源码</name><url>https://github.com/yudaocode</url></developer></developers>
	<scm><connection>scm:git:https://github.com/yudaocode/yudao-spring-ai.git</connection><developerConnection>scm:git:ssh://git@github.com/yudaocode/yudao-spring-ai.git</developerConnection><url>https://github.com/yudaocode/yudao-spring-ai/tree/main-jdk8</url></scm>
	<dependencies>
		<dependency>
			<groupId>redis.clients</groupId>
			<artifactId>jedis</artifactId>
			<version>6.0.0</version>
			<optional>true</optional>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<excludeArtifactIds>slf4j-api</excludeArtifactIds>
							<outputDirectory>${project.build.directory}/upstream-runtime</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.3</version>
				<dependencies>
					<dependency>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<version>3.5.0</version>
					</dependency>
					<dependency>
						<groupId>org.apache.maven</groupId>
						<artifactId>maven-plugin-api</artifactId>
						<version>3.9.16</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<phase>generate-resources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<includePluginDependencies>true</includePluginDependencies>
					<executable>${java.home}/bin/java</executable>
					<arguments>
						<argument>--source</argument>
						<argument>17</argument>
						<argument>-cp</argument>
						<classpath/>
						<argument>${project.basedir}/GenerateJedisRuntime.java</argument>
						<argument>${project.build.directory}/upstream-runtime</argument>
						<argument>${project.build.outputDirectory}</argument>
						<argument>${project.basedir}/upstream-sha256.properties</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<properties>
		<maven.compiler.release>8</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
</project>
