<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.spring-ai</groupId>
        <artifactId>spring-ai-parent</artifactId>
        <version>2.1.1-jdk8-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>spring-ai-coherence-ai-compat</artifactId>
    <properties>
        <disable.checks>true</disable.checks>
        <coherence-java8-core.version>14.1.1-0-29</coherence-java8-core.version>
        <coherence-ai-source.version>24.09</coherence-ai-source.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.oracle.coherence.ce</groupId>
            <artifactId>coherence</artifactId>
            <version>${coherence-java8-core.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.5.16</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>java8-main-sources</id>
                        <configuration>
                            <arguments combine.self="override">
                                <argument>--source</argument>
                                <argument>17</argument>
                                <argument>-cp</argument>
                                <classpath />
                                <argument>${maven.multiModuleProjectDirectory}/compatibility/java8/Java8SourceGenerator.java</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.directory}/generated-sources/java8</argument>
                                <argument>org.springframework.ai.compat.coherence</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <version>3.6.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>native-hnsw-payload</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.oracle.coherence.ce</groupId>
                                    <artifactId>coherence-hnsw</artifactId>
                                    <version>${coherence-ai-source.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <includes>**/*.so,**/*.dylib,**/*.dll,**/*.exp,**/*.libw,**/*.xml</includes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <name>Coherence24.09 vector capabilities for Java8</name>
    <licenses>
        <license>
            <name>Universal Permissive License1.0</name>
            <url>https://oss.oracle.com/licenses/upl/</url>
        </license>
        <license>
            <name>Apache License2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
</project>