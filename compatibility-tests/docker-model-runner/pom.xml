<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath />
    </parent>
    <groupId>cn.iocoder.spring-ai.compatibility</groupId>
    <artifactId>docker-model-runner</artifactId>
    <version>2.1.0-jdk8-SNAPSHOT</version>
    <properties>
        <java.version>8</java.version>
        <maven.compiler.release>8</maven.compiler.release>
        <compat.test.jvm>${java.home}/bin/java</compat.test.jvm>
        <compat.java.version>1.8</compat.java.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <kotlin.version>2.1.21</kotlin.version>
        <micrometer.version>1.15.12</micrometer.version>
        <jackson-bom.version>2.21.4</jackson-bom.version>
        <okhttp.version>4.12.0</okhttp.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iocoder.spring-ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.spring-ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <jvm>${compat.test.jvm}</jvm>
                    <systemPropertyVariables>
                        <compat.boot.version>${project.parent.version}</compat.boot.version>
                        <compat.java.version>${compat.java.version}</compat.java.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
